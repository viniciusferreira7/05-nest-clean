		"zod": "^3.24.4",
		"zod-validation-error": "^3.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.2",
		"@faker-js/faker": "^9.5.1",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
